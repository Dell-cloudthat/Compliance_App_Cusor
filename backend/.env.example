# ── Compliance Platform backend environment ──────────────────────────────────
# Copy to .env (or export in your process manager) and fill in real values.
# In development every variable is optional — safe local fallbacks exist.
# In production (APP_ENV=production) the server REFUSES TO START unless
# JWT_SECRET_KEY, ENCRYPTION_KEY, and CORS_ORIGINS are set.

# development | production
APP_ENV=development

# JWT signing key. Generate: openssl rand -hex 32
# Dev fallback: random key persisted to backend/.jwt_secret_key
JWT_SECRET_KEY=

# Fernet key encrypting stored vendor credentials (BYOC integrations).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Dev fallback: random key persisted to backend/.encryption_key
# WARNING: rotating this key makes previously stored credentials unreadable.
ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins (no wildcard).
# Example: CORS_ORIGINS=https://app.example.com,https://staging.example.com
# Dev fallback: localhost:5173-5176 and localhost:3000
CORS_ORIGINS=

# Set by the test suite automatically (tests/conftest.py) to disable the
# auth-endpoint rate limiter — do not set this in development or production.
TESTING=

# Optional — Groq API key for the AI controls assistant (free tier available
# at console.groq.com). Without it the assistant falls back to retrieval-only
# answers built from your controls data.
GROQ_API_KEY=

# Optional — override the Groq model used by the assistant.
GROQ_MODEL=llama-3.1-8b-instant

# Optional — AWS credentials for Glacier archival of violation records.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GLACIER_BUCKET=
